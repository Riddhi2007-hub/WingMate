# Copy this file to a new file named  .env  (same folder), fill it in, and save. It is never uploaded to GitHub.
# Needed only to send REAL confirmation / password-reset emails. Without it the links are printed in the window instead.
# Gmail: turn on 2-step verification, then create an "app password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
SMTP_FROM=WingMate <you@gmail.com>
